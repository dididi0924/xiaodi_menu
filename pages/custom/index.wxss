.custom-page { min-height: 100vh; background: var(--paper); padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.custom-nav { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; padding: 0 28rpx; }
.nav-side { width: 80rpx; height: 72rpx; display: flex; align-items: center; }
.nav-icon { width: 32rpx; height: 32rpx; }
.nav-title { font-size: 25rpx; font-weight: 700; }
.custom-head { padding: 18rpx 40rpx 0; }
.custom-title { font-size: 50rpx; font-weight: 700; letter-spacing: -0.05em; }
.custom-sub { margin-top: 6rpx; color: var(--muted); font-size: 19rpx; }

.custom-preview { display: flex; align-items: center; gap: 20rpx; margin: 30rpx 40rpx 0; padding: 22rpx; border: 2rpx dashed var(--line-strong); border-radius: 28rpx; background: rgba(255,253,248,0.35); }
.preview-mark {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #CF9F7A, #8F6B52);
  color: var(--white);
  font-family: Georgia, "Songti SC", serif;
  font-size: 42rpx;
}
.preview-copy { flex: 1; min-width: 0; }
.preview-title { font-size: 19rpx; font-weight: 600; }
.preview-text { margin-top: 4rpx; color: var(--muted); font-size: 16rpx; line-height: 1.5; }

.custom-form { padding: 30rpx 40rpx 0; }
.form-field { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 26rpx; }
.form-row { display: flex; gap: 18rpx; }
.form-field--half { flex: 1; min-width: 0; }
.form-label { display: flex; align-items: center; justify-content: space-between; color: var(--ink-soft); font-size: 20rpx; font-weight: 600; }
.form-label text { color: var(--muted-light); font-size: 15rpx; font-weight: 400; }
.form-input { width: 100%; height: 88rpx; padding: 0 22rpx; border: 1px solid var(--line); border-radius: 24rpx; background: var(--card); font-size: 21rpx; }
.form-textarea { width: 100%; height: 150rpx; padding: 20rpx 22rpx; border: 1px solid var(--line); border-radius: 24rpx; background: var(--card); font-size: 21rpx; line-height: 1.6; }
.form-placeholder { color: var(--muted-light); }
.form-select { height: 88rpx; padding: 0 22rpx; display: flex; align-items: center; justify-content: space-between; border: 1px solid var(--line); border-radius: 24rpx; background: var(--card); font-size: 21rpx; }
.select-icon { width: 22rpx; height: 22rpx; }
.time-wrap { position: relative; }
.time-wrap .form-input { padding-right: 100rpx; }
.time-unit { position: absolute; right: 22rpx; top: 0; height: 88rpx; line-height: 88rpx; color: var(--muted-light); font-size: 16rpx; }
.form-hint { color: var(--muted-light); font-size: 15rpx; line-height: 1.6; }

.custom-footer { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; padding: 18rpx 40rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: rgba(244,240,231,0.97); }
.custom-submit { height: 96rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; border-radius: 28rpx; background: var(--ink); color: var(--white); font-size: 23rpx; font-weight: 600; }
.custom-submit__icon { width: 28rpx; height: 28rpx; }

.preview-page { min-height: 100vh; padding: 0 40rpx calc(48rpx + env(safe-area-inset-bottom)); background: var(--paper); }
.preview-top { padding-left: 2rpx; }
.preview-brand { display: flex; align-items: baseline; font-family: Georgia, "Songti SC", serif; font-size: 46rpx; font-weight: 600; line-height: 1; color: var(--ink); }
.preview-brand text { line-height: 1; }
.preview-kicker { margin-top: 70rpx; color: var(--tomato); font-size: 15rpx; font-weight: 600; letter-spacing: 0.16em; }
.preview-title { margin-top: 14rpx; font-size: 56rpx; font-weight: 700; line-height: 1.14; letter-spacing: -0.055em; }
.preview-title text { display: block; color: var(--tomato); font-family: Georgia, "Songti SC", serif; font-style: italic; font-weight: 400; }
.preview-sub { margin-top: 16rpx; max-width: 620rpx; color: var(--muted); font-size: 20rpx; line-height: 1.7; }
.preview-hero { position: relative; height: 330rpx; margin-top: 30rpx; overflow: hidden; border-radius: 34rpx; background: #2B261E; }
.preview-hero__img { width: 100%; height: 100%; }
.preview-hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(25,21,16,0.08), rgba(25,21,16,0.72)); }
.preview-hero__copy { position: absolute; left: 28rpx; right: 28rpx; bottom: 26rpx; color: var(--white); }
.preview-hero__kicker { font-size: 13rpx; letter-spacing: 0.16em; color: rgba(255,253,248,0.68); }
.preview-hero__title { margin-top: 6rpx; font-size: 32rpx; font-weight: 700; }
.preview-hero__sub { margin-top: 6rpx; font-size: 17rpx; color: rgba(255,253,248,0.78); }
.preview-section { margin-top: 38rpx; }
.preview-section__head { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 14rpx; border-bottom: 1px solid var(--line); }
.preview-section__head text:first-child { font-size: 24rpx; font-weight: 700; }
.preview-section__head text:last-child { color: var(--muted-light); font-size: 15rpx; }
.preview-grid { display: flex; flex-wrap: wrap; gap: 18rpx; margin-top: 18rpx; }
.preview-dish { width: calc(50% - 9rpx); overflow: hidden; border: 1px solid var(--line); border-radius: 24rpx; background: #FFFDF8; }
.preview-dish__img { width: 100%; height: 190rpx; }
.preview-dish__info { padding: 14rpx 16rpx 18rpx; }
.preview-dish__name { font-size: 21rpx; font-weight: 700; }
.preview-dish__meta { margin-top: 4rpx; color: var(--muted); font-size: 14rpx; }
.preview-steps { margin-top: 8rpx; }
.preview-step { display: flex; gap: 18rpx; padding: 20rpx 0; border-bottom: 1px solid var(--line); }
.preview-step > text { color: var(--tomato); font-family: Georgia, serif; font-size: 30rpx; line-height: 1; }
.preview-step__title { font-size: 21rpx; font-weight: 600; }
.preview-step__sub { margin-top: 4rpx; color: var(--muted); font-size: 15rpx; }
.preview-cta { margin-top: 40rpx; padding: 30rpx 28rpx; border-radius: 30rpx; background: var(--paper-deep); }
.preview-cta__title { font-size: 26rpx; font-weight: 700; }
.preview-cta__sub { margin-top: 6rpx; color: var(--muted); font-size: 15rpx; line-height: 1.6; }
.preview-cta__btn { min-height: 92rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--ink); color: var(--white); font-size: 22rpx; font-weight: 600; }

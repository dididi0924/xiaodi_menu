.me-head { padding-top: 34rpx; }
.me-kicker { margin-bottom: 12rpx; color: var(--muted-light); font-size: 16rpx; font-weight: 600; letter-spacing: 0.17em; }
.me-title { font-size: 60rpx; font-weight: 700; line-height: 1.08; letter-spacing: -0.055em; }
.me-sub { margin-top: 10rpx; color: var(--muted); font-size: 20rpx; }

.profile-card {
  position: relative;
  margin-top: 30rpx;
  padding: 32rpx;
  overflow: hidden;
  border-radius: 42rpx;
  background: #E8E2D5;
  box-shadow: 0 12rpx 36rpx -28rpx rgba(45,38,26,0.3);
}
.profile-card::after {
  content: "&";
  position: absolute;
  right: 14rpx;
  bottom: -48rpx;
  font-family: Georgia, serif;
  font-size: 246rpx;
  line-height: 1;
  color: rgba(29,28,24,0.055);
  pointer-events: none;
}
.profile-top { position: relative; z-index: 1; display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.profile-avatars { display: flex; }
.profile-avatar { width: 82rpx; height: 82rpx; border-radius: 50%; border: 4rpx solid #E8E2D5; }
.profile-avatar + .profile-avatar { margin-left: -22rpx; }
.profile-since-wrap { text-align: right; }
.profile-label { color: var(--muted); font-size: 15rpx; font-weight: 600; letter-spacing: 0.16em; }
.profile-since { margin-top: 6rpx; color: var(--ink-soft); font-size: 18rpx; }
.profile-names { position: relative; z-index: 1; display: flex; align-items: baseline; gap: 12rpx; margin-top: 34rpx; }
.profile-name { font-size: 46rpx; font-weight: 700; letter-spacing: -0.055em; }
.profile-amp { font-family: Georgia, serif; font-size: 34rpx; font-style: italic; color: var(--tomato); }
.profile-meta { position: relative; z-index: 1; display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; color: var(--muted); font-size: 17rpx; }
.dot { width: 4rpx; height: 4rpx; border-radius: 50%; background: var(--muted-light); }
.profile-footer {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-top: 22rpx;
  border-top: 1px solid rgba(29,28,24,0.1);
}
.code-label { display: block; color: var(--muted); font-size: 14rpx; letter-spacing: 0.08em; }
.code-value { display: block; margin-top: 4rpx; font-family: Georgia, serif; font-size: 26rpx; font-weight: 600; letter-spacing: 0.06em; }
.code-copy { display: flex; align-items: center; gap: 7rpx; color: var(--ink-soft); font-size: 16rpx; font-weight: 600; }
.code-copy__icon { width: 22rpx; height: 22rpx; }

.invite-banner {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: var(--ink);
  color: var(--white);
}
.invite-banner::after {
  content: "";
  position: absolute;
  right: -36rpx;
  top: -50rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(228,85,61,0.34);
}
.invite-banner__icon { position: relative; z-index: 1; width: 66rpx; height: 66rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 21rpx; background: rgba(255,253,248,0.12); }
.invite-banner__img { width: 32rpx; height: 32rpx; }
.invite-banner__copy { position: relative; z-index: 1; flex: 1; min-width: 0; }
.invite-banner__title { font-size: 20rpx; font-weight: 600; }
.invite-banner__sub { margin-top: 4rpx; color: rgba(255,253,248,0.56); font-size: 16rpx; }
.invite-banner__arrow { position: relative; z-index: 1; width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,253,248,0.12); }
.invite-banner__arrow-img { width: 26rpx; height: 26rpx; }

.me-section { margin-top: 40rpx; }
.me-section-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 14rpx; padding: 0 4rpx; }
.me-section-head text:first-child { font-size: 21rpx; font-weight: 600; }
.me-section-head text:last-child { color: var(--muted-light); font-size: 16rpx; }
.settings-card { overflow: hidden; border: 1px solid var(--line); border-radius: 32rpx; background: rgba(255,253,248,0.46); }
.settings-row { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; padding: 18rpx 22rpx; }
.settings-row + .settings-row { border-top: 1px solid var(--line); }
.row-icon { width: 54rpx; height: 54rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; background: var(--paper-deep); }
.row-icon--tomato { background: var(--tomato-soft); }
.row-icon--sage { background: var(--sage-soft); }
.row-icon__img { width: 26rpx; height: 26rpx; }
.row-copy { flex: 1; min-width: 0; }
.row-title { font-size: 19rpx; font-weight: 600; }
.row-sub { margin-top: 4rpx; color: var(--muted); font-size: 16rpx; }
.row-tail { display: flex; align-items: center; gap: 4rpx; color: var(--muted-light); font-size: 16rpx; }
.row-chev { width: 22rpx; height: 22rpx; }

.pref-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.pref-chip { display: flex; align-items: center; gap: 6rpx; padding: 10rpx 18rpx; border: 1px solid var(--line); border-radius: 999rpx; color: var(--muted); font-size: 17rpx; }
.pref-chip--accent { border-color: transparent; background: var(--sage-soft); color: var(--sage); }
.pref-icon { width: 20rpx; height: 20rpx; }

.role-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; padding: 8rpx; border: 1px solid var(--line); border-radius: 30rpx; background: rgba(255,253,248,0.4); }
.role-option { display: flex; align-items: center; gap: 14rpx; padding: 16rpx; border-radius: 22rpx; }
.role-option.is-active { background: var(--card); box-shadow: 0 4rpx 16rpx rgba(30,25,18,0.07); }
.role-avatar { width: 52rpx; height: 52rpx; border-radius: 50%; }
.role-name { font-size: 18rpx; font-weight: 600; color: var(--muted); }
.role-option.is-active .role-name { color: var(--ink); }
.role-sub { margin-top: 2rpx; color: var(--muted); font-size: 15rpx; }
.role-note { margin-top: 12rpx; padding: 0 6rpx; color: var(--muted-light); font-size: 15rpx; line-height: 1.5; }

.switch { width: 76rpx; height: 46rpx; flex: 0 0 auto; padding: 6rpx; border-radius: 999rpx; background: rgba(29,28,24,0.18); }
.switch.is-on { background: var(--sage); }
.switch-knob { width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--white); box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15); transition: transform 0.22s; }
.switch.is-on .switch-knob { transform: translateX(30rpx); }

.app-about { padding: 46rpx 4rpx 24rpx; text-align: center; color: var(--muted-light); font-size: 15rpx; line-height: 1.7; }
.about-mark { margin-bottom: 8rpx; display: flex; align-items: baseline; justify-content: center; font-family: Georgia, "Songti SC", serif; font-size: 36rpx; line-height: 1; letter-spacing: 0; color: var(--muted); }
.about-mark text { line-height: 1; }
.about-mark .brand-accent { color: var(--tomato); }
.about-reset { display: inline-flex; align-items: center; gap: 6rpx; margin-top: 6rpx; color: var(--muted-light); font-size: 15rpx; text-decoration: underline; text-underline-offset: 5rpx; }
.about-reset__icon { width: 18rpx; height: 18rpx; }

.pref-empty { padding: 18rpx 4rpx 0; color: var(--muted-light); font-size: 16rpx; line-height: 1.6; }

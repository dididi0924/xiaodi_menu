.dish-page { min-height: 100vh; background: var(--paper); padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.dish-hero { position: relative; height: 520rpx; overflow: hidden; background: var(--paper-deep); }
.dish-hero__img,
.dish-hero__cover { width: 100%; height: 100%; }
.dish-hero__cover { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: var(--white); }
.dish-hero__cover .custom-cover__char { font-size: 154rpx; }
.dish-hero__shade {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(180deg, rgba(20,17,12,0.22), transparent 28%, transparent 72%, rgba(20,17,12,0.16));
}
.nav-actions {
  position: absolute;
  z-index: 3;
  left: 28rpx;
  right: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.round-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,253,248,0.9);
  box-shadow: 0 8rpx 20rpx rgba(20,17,12,0.12);
}
.round-btn.is-liked { background: var(--white); }
.round-icon { width: 30rpx; height: 30rpx; }

.dish-content { padding: 36rpx 40rpx 12rpx; }
.dish-eyebrow {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--tomato);
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.dot { width: 5rpx; height: 5rpx; border-radius: 50%; background: currentColor; }
.dish-title {
  margin-top: 12rpx;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -0.055em;
}
.dish-en {
  margin-top: 6rpx;
  font-family: Georgia, serif;
  font-size: 24rpx;
  font-style: italic;
  color: var(--muted-light);
}
.dish-desc { margin-top: 28rpx; color: var(--ink-soft); font-size: 23rpx; line-height: 1.85; }
.tag-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 24rpx; }
.tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 9rpx 16rpx;
  border: 1px solid var(--line);
  border-radius: 999rpx;
  color: var(--muted);
  font-size: 17rpx;
}
.tag--warm { border-color: transparent; background: var(--tomato-soft); color: var(--tomato-dark); }
.tag-icon { width: 20rpx; height: 20rpx; }
.chef-note {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 32rpx;
  padding: 22rpx;
  border: 1px solid rgba(104,116,92,0.14);
  border-radius: 30rpx;
  background: rgba(223,230,215,0.42);
}
.chef-avatar { width: 54rpx; height: 54rpx; border-radius: 50%; flex: 0 0 auto; }
.chef-copy { min-width: 0; }
.chef-label { color: var(--sage); font-size: 15rpx; font-weight: 600; letter-spacing: 0.12em; }
.chef-text { margin-top: 5rpx; color: var(--ink-soft); font-size: 19rpx; line-height: 1.55; }
.detail-divider { height: 1px; margin: 34rpx 0 28rpx; background: var(--line); }
.option-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.option-title { font-size: 22rpx; font-weight: 600; }
.option-hint { margin-top: 4rpx; color: var(--muted); font-size: 17rpx; }
.stepper {
  display: flex;
  align-items: center;
  height: 70rpx;
  padding: 6rpx;
  border: 1px solid var(--line);
  border-radius: 999rpx;
  background: var(--card);
}
.stepper-btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
.stepper-icon { width: 24rpx; height: 24rpx; }
.stepper-num { min-width: 42rpx; text-align: center; font-size: 22rpx; font-weight: 600; }
.note-label { margin-bottom: 12rpx; font-size: 22rpx; font-weight: 600; }
.note-label text { color: var(--muted-light); font-size: 17rpx; font-weight: 400; }
.note-input {
  width: 100%;
  height: 132rpx;
  padding: 20rpx 22rpx;
  border: 1px solid var(--line);
  border-radius: 24rpx;
  background: var(--card);
  font-size: 21rpx;
  line-height: 1.55;
}
.note-placeholder { color: var(--muted-light); }

.dish-footer {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1px solid var(--line);
  background: rgba(244,240,231,0.97);
}
.dish-from { flex: 0 0 auto; color: var(--muted); font-size: 16rpx; line-height: 1.35; }
.dish-from__strong { color: var(--ink-soft); font-size: 19rpx; font-weight: 600; }
.add-btn {
  flex: 1;
  min-height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 28rpx;
  background: var(--ink);
  color: var(--white);
  font-size: 23rpx;
  font-weight: 600;
}
.add-icon { width: 28rpx; height: 28rpx; }

.stepper-symbol { font-size: 34rpx; line-height: 1; color: #1D1C18; font-weight: 300; }

.photo-edit { position: absolute; z-index: 4; right: 26rpx; bottom: 26rpx; height: 64rpx; padding: 0 20rpx; display: flex; align-items: center; gap: 8rpx; border-radius: 999rpx; background: rgba(255,253,248,0.94); color: var(--ink); font-size: 16rpx; font-weight: 600; box-shadow: 0 8rpx 24rpx rgba(20,17,12,0.16); }
.photo-edit.is-loading { opacity: 0.72; }
.photo-edit__icon { width: 24rpx; height: 24rpx; }

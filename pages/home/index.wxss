/* Home */
.page.has-cart { padding-bottom: calc(330rpx + env(safe-area-inset-bottom)); }

.greeting { padding-top: 28rpx; }
.group-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  color: var(--muted);
  font-size: 20rpx;
  font-weight: 500;
}
.group-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--sage);
  box-shadow: 0 0 0 6rpx rgba(104,116,92,0.13);
}
.group-chev { width: 20rpx; height: 20rpx; opacity: 0.75; }
.hello { margin-bottom: 12rpx; color: var(--muted); font-size: 20rpx; }
.headline {
  max-width: 640rpx;
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1.14;
  letter-spacing: -0.055em;
}
.subline { margin-top: 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  margin-top: 30rpx;
  padding: 0 24rpx;
  border: 1px solid var(--line);
  border-radius: 28rpx;
  background: rgba(255,253,248,0.7);
}
.search-icon { width: 32rpx; height: 32rpx; }
.search-input { flex: 1; min-width: 0; height: 84rpx; font-size: 23rpx; color: var(--ink); }
.search-placeholder { color: var(--muted-light); }
.search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--paper-deep);
}
.search-clear-icon { width: 24rpx; height: 24rpx; }

.hero-card {
  position: relative;
  display: block;
  min-height: 220rpx;
  margin-top: 34rpx;
  overflow: hidden;
  border-radius: 44rpx;
  background: #4C4438;
  box-shadow: 0 22rpx 44rpx -28rpx rgba(42,33,20,0.72);
}
.hero-card--pressed { transform: scale(0.992); }
.hero-card--order { background: #4A241B; }
.hero-bg { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.hero-shade {
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(90deg, rgba(25,21,16,0.87) 0%, rgba(25,21,16,0.56) 56%, rgba(25,21,16,0.16) 100%);
}
.hero-card--order .hero-shade {
  background: linear-gradient(90deg, rgba(61,25,18,0.91) 0%, rgba(83,34,24,0.62) 62%, rgba(83,34,24,0.22) 100%);
}
.hero-content {
  position: relative;
  z-index: 1;
  min-height: 220rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}
.hero-main { flex: 1; min-width: 0; }
.hero-avatars { margin-bottom: 18rpx; }
.hero-avatars .avatar { width: 50rpx; height: 50rpx; border-width: 3rpx; }
.hero-kicker {
  margin-bottom: 8rpx;
  color: rgba(255,253,248,0.62);
  font-size: 15rpx;
  font-weight: 600;
  letter-spacing: 0.17em;
}
.hero-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--white);
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: -0.015em;
}
.hero-sub {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(255,253,248,0.66);
  font-size: 18rpx;
}
.arrow-circle {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,253,248,0.14);
}
.arrow-icon { width: 28rpx; height: 28rpx; }

.rail {
  margin: 0 -40rpx;
  width: auto;
  white-space: nowrap;
}
.rail-inner {
  display: flex;
  gap: 18rpx;
  padding: 0 40rpx 6rpx;
}
.usual-card {
  position: relative;
  flex: 0 0 292rpx;
  width: 292rpx;
  height: 324rpx;
  overflow: hidden;
  border-radius: 38rpx;
  background: var(--paper-deep);
  box-shadow: 0 12rpx 34rpx -26rpx rgba(45,38,26,0.32);
}
.usual-img { width: 100%; height: 100%; }
.usual-card::after {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background: linear-gradient(180deg, rgba(20,17,13,0.05) 24%, rgba(20,17,13,0.06) 48%, rgba(20,17,13,0.78) 100%);
}
.usual-badge {
  position: absolute;
  z-index: 2;
  top: 18rpx;
  left: 18rpx;
  padding: 8rpx 14rpx;
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 999rpx;
  background: rgba(24,22,18,0.36);
  color: rgba(255,253,248,0.92);
  font-size: 16rpx;
  font-weight: 600;
}
.usual-body {
  position: absolute;
  z-index: 2;
  left: 22rpx;
  right: 82rpx;
  bottom: 22rpx;
  color: var(--white);
}
.usual-name { font-size: 24rpx; font-weight: 600; line-height: 1.28; letter-spacing: -0.02em; }
.usual-meta { margin-top: 5rpx; color: rgba(255,253,248,0.62); font-size: 16rpx; }
.add-mini {
  position: absolute;
  z-index: 3;
  right: 18rpx;
  bottom: 18rpx;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--white);
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
}
.add-mini .icon { width: 26rpx; height: 26rpx; }

.chips-inner { display: flex; gap: 12rpx; white-space: nowrap; }

.custom-card {
  min-height: 370rpx;
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 2rpx dashed var(--line-strong);
  border-radius: 36rpx;
  background: rgba(255,253,248,0.3);
  text-align: center;
}
.custom-plus {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line-strong);
  border-radius: 50%;
}
.custom-plus .icon { width: 28rpx; height: 28rpx; }
.custom-card-title { font-size: 22rpx; font-weight: 600; color: var(--ink-soft); }
.custom-card-text { color: var(--muted); font-size: 17rpx; line-height: 1.55; }

.show-all-wrap { display: flex; justify-content: center; margin-top: 28rpx; }
.show-all-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 74rpx;
  padding: 0 30rpx;
  border: 1px solid var(--line);
  border-radius: 999rpx;
  background: rgba(255,253,248,0.5);
  color: var(--ink-soft);
  font-size: 19rpx;
  font-weight: 600;
}
.show-all-btn .icon { width: 22rpx; height: 22rpx; }

.custom-add-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 24rpx auto 0;
  padding: 14rpx 18rpx;
  color: var(--muted);
  font-size: 18rpx;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}
.custom-add-link .icon { width: 22rpx; height: 22rpx; }

.cart-float {
  position: fixed;
  z-index: 80;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(164rpx + env(safe-area-inset-bottom));
  min-height: 102rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 34rpx;
  background: rgba(25,24,21,0.97);
  color: var(--white);
  box-shadow: 0 24rpx 48rpx -24rpx rgba(24,20,14,0.65);
}
.cart-count {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--tomato);
  font-family: Georgia, serif;
  font-size: 30rpx;
  font-weight: 600;
}
.cart-float__copy { flex: 1; min-width: 0; }
.cart-float__title { font-size: 22rpx; font-weight: 600; }
.cart-float__meta { margin-top: 3rpx; color: rgba(255,253,248,0.58); font-size: 17rpx; }
.cart-float__arrow {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,253,248,0.12);
}
.cart-float__arrow .icon { width: 28rpx; height: 28rpx; }

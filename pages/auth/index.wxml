<view class="auth-page">
  <view class="auth-hero">
    <image class="auth-hero__img" src="/assets/hero-table.jpg" mode="aspectFill"></image>
    <view class="auth-hero__shade"></view>
    <view class="auth-brand" style="top: {{navTop}}px;"><text>koodi</text><text class="brand-accent brand-accent--tight">98</text></view>
    <view class="auth-hero__note">A TABLE FOR KOODI98</view>
  </view>

  <view class="auth-panel">
    <view class="auth-card">
      <view class="auth-kicker">WELCOME TO KOODI98</view>
      <view class="auth-title">今晚，<text>从一张菜单开始。</text></view>
      <view class="auth-sub">登录后，先给这张只属于两个人的餐桌加一道菜，再把邀请发给 TA。</view>

      <view class="auth-profile">
        <button class="auth-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="选择微信头像">
          <image class="auth-avatar__img" src="{{avatar}}" mode="aspectFill"></image>
          <view class="auth-avatar__badge">{{avatarLoading ? '…' : '+'}}</view>
        </button>
        <view class="auth-name">
          <view class="auth-name__label">微信昵称</view>
          <input class="auth-name__input" type="nickname" value="{{nickname}}" maxlength="12" focus="{{nicknameFocus}}" confirm-type="done" placeholder="点击填入微信昵称" placeholder-class="auth-name__placeholder" bindinput="onNickname" bindconfirm="onNicknameConfirm" />
          <view class="auth-name__hint">微信不会自动提供昵称，需要你在这里确认一次。</view>
        </view>
      </view>

      <view class="auth-points">只属于两个人 · {{dishCount}} 道家常菜 · 一纸留言</view>

      <view class="auth-login {{loading ? 'is-loading' : ''}}" bindtap="login" aria-role="button" aria-label="微信一键登录">
        <view class="auth-login__dot"></view>
        {{loading ? '正在进入…' : '进入餐桌'}}
      </view>
      <view class="auth-name__hint auth-name__hint--below">选头像后会自动跳到昵称；按键盘「完成」直接进入。</view>
      <view class="auth-legal">{{isCloud ? '登录即创建一张私密餐桌 · 双方数据云端同步' : '登录即创建一张私密餐桌 · 数据只保存在当前设备'}}</view>
      <view class="auth-preview" bindtap="preview">先逛逛菜单，不登录</view>
    </view>
  </view>
</view>

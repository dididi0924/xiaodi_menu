.auth-page { min-height: 100vh; background: var(--paper); padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
.auth-hero { position: relative; height: 620rpx; min-height: 46vh; overflow: hidden; background: #2B261E; }
.auth-hero__img { width: 100%; height: 100%; }
.auth-hero__shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(25,21,16,0.28), rgba(25,21,16,0.5)); }
.auth-brand { position: absolute; z-index: 2; left: 42rpx; color: var(--white); font-family: Georgia, serif; font-size: 54rpx; font-weight: 600; letter-spacing: -3rpx; }
.auth-brand text { color: var(--tomato); }
.auth-hero__note { position: absolute; z-index: 2; left: 42rpx; bottom: 46rpx; color: rgba(255,253,248,0.7); font-size: 15rpx; letter-spacing: 0.14em; }
.auth-panel { position: relative; z-index: 3; margin-top: -80rpx; padding: 0 40rpx; }
.auth-card { padding: 42rpx 36rpx 34rpx; border-radius: 46rpx; background: var(--paper); box-shadow: 0 -20rpx 70rpx rgba(25,21,16,0.16); }
.auth-kicker { color: var(--tomato); font-size: 15rpx; font-weight: 600; letter-spacing: 0.14em; }
.auth-title { margin-top: 14rpx; font-size: 50rpx; font-weight: 700; line-height: 1.16; letter-spacing: -0.055em; }
.auth-title text { display: block; color: var(--tomato); font-family: Georgia, "Songti SC", serif; font-style: italic; font-weight: 400; }
.auth-sub { margin-top: 16rpx; color: var(--muted); font-size: 20rpx; line-height: 1.7; }
.auth-features { margin-top: 30rpx; padding: 22rpx 20rpx; border: 1px solid var(--line); border-radius: 28rpx; background: rgba(255,253,248,0.45); }
.auth-feature { display: flex; align-items: flex-start; gap: 14rpx; padding: 10rpx 0; }
.auth-feature + .auth-feature { border-top: 1px solid var(--line); }
.feature-dot { width: 10rpx; height: 10rpx; margin-top: 12rpx; flex: 0 0 auto; border-radius: 50%; background: var(--tomato); }
.feature-copy text { display: block; }
.feature-copy text:first-child { font-size: 19rpx; font-weight: 600; }
.feature-copy text:last-child { margin-top: 3rpx; color: var(--muted); font-size: 16rpx; line-height: 1.5; }
.auth-login {
  min-height: 96rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 28rpx;
  background: var(--ink);
  color: var(--white);
  font-size: 23rpx;
  font-weight: 600;
}
.auth-login.is-loading { opacity: 0.7; }
.auth-login__dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #7ED321; box-shadow: 0 0 0 5rpx rgba(126,211,33,0.14); }
.auth-legal { margin-top: 16rpx; color: var(--muted-light); font-size: 14rpx; line-height: 1.5; text-align: center; }

.cart-page { min-height: 100vh; background: var(--paper); padding-bottom: calc(250rpx + env(safe-area-inset-bottom)); }
.cart-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}
.nav-side { width: 88rpx; height: 72rpx; display: flex; align-items: center; }
.nav-side--text { justify-content: flex-end; color: var(--muted); font-size: 18rpx; font-weight: 600; }
.nav-icon { width: 32rpx; height: 32rpx; }
.nav-title { font-size: 27rpx; font-weight: 700; letter-spacing: -0.02em; }

.cart-head { padding: 10rpx 40rpx 0; }
.cart-title { font-size: 52rpx; font-weight: 700; letter-spacing: -0.055em; }
.cart-sub { margin-top: 6rpx; color: var(--muted); font-size: 20rpx; }

.cart-list { margin: 26rpx 40rpx 0; }
.cart-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1px solid var(--line);
}
.cart-thumb {
  width: 118rpx;
  height: 118rpx;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 26rpx;
  background: var(--paper-deep);
}
.cart-thumb image { width: 100%; height: 100%; }
.thumb-char { font-family: Georgia, "Songti SC", serif; font-size: 46rpx; color: var(--white); }
.cart-info { flex: 1; min-width: 0; }
.cart-name { font-size: 23rpx; font-weight: 600; line-height: 1.3; }
.cart-note { margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 17rpx; }
.cart-actions { display: flex; align-items: center; gap: 12rpx; }
.mini-stepper {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 4rpx;
  border: 1px solid var(--line);
  border-radius: 999rpx;
  background: var(--card);
}
.mini-btn { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.mini-num { min-width: 32rpx; text-align: center; font-size: 20rpx; font-weight: 600; }
.cart-remove { width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; }
.remove-icon { width: 28rpx; height: 28rpx; }

.order-target {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 24rpx 40rpx 0;
  padding: 20rpx;
  border: 1px solid var(--line);
  border-radius: 28rpx;
  background: rgba(255,253,248,0.42);
}
.target-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; }
.target-copy { flex: 1; min-width: 0; }
.target-label { color: var(--muted-light); font-size: 14rpx; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; }
.target-name { margin-top: 3rpx; font-size: 20rpx; font-weight: 600; }
.target-sub { margin-top: 2rpx; color: var(--muted); font-size: 16rpx; }
.target-status { color: var(--sage); font-size: 16rpx; font-weight: 600; }
.target-status::before { content: ""; display: inline-block; width: 8rpx; height: 8rpx; margin-right: 6rpx; border-radius: 50%; background: var(--sage); }

.message-block { margin: 32rpx 40rpx 0; }
.field-label { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; font-size: 21rpx; font-weight: 600; }
.field-label text { color: var(--muted-light); font-size: 16rpx; font-weight: 400; }
.message-box {
  width: 100%;
  height: 170rpx;
  padding: 22rpx 24rpx;
  border: 1px solid var(--line);
  border-radius: 28rpx;
  background: var(--card);
  font-size: 21rpx;
  line-height: 1.65;
}
.message-placeholder { color: var(--muted-light); }
.message-meta { display: flex; justify-content: space-between; margin-top: 9rpx; color: var(--muted-light); font-size: 16rpx; }
.quick-notes { margin: 14rpx -40rpx 0; }
.quick-notes-inner { display: flex; gap: 10rpx; padding: 0 40rpx; white-space: nowrap; }
.quick-note {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  border: 1px solid var(--line);
  border-radius: 999rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.notify-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 30rpx 40rpx 0;
  padding: 22rpx;
  border: 1px solid var(--line);
  border-radius: 28rpx;
  background: rgba(255,253,248,0.42);
}
.notify-icon-wrap { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; background: var(--butter); }
.notify-icon { width: 28rpx; height: 28rpx; }
.notify-copy { flex: 1; min-width: 0; }
.notify-title { font-size: 20rpx; font-weight: 600; }
.notify-sub { margin-top: 4rpx; color: var(--muted); font-size: 16rpx; }
.switch {
  width: 76rpx;
  height: 46rpx;
  flex: 0 0 auto;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(29,28,24,0.18);
  transition: background 0.2s;
}
.switch.is-on { background: var(--sage); }
.switch-knob { width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--white); box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15); transition: transform 0.22s; }
.switch.is-on .switch-knob { transform: translateX(30rpx); }

.cart-bottom-space { height: 30rpx; }
.checkout-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid var(--line);
  background: rgba(244,240,231,0.97);
}
.checkout-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; color: var(--muted); font-size: 17rpx; }
.checkout-eta { display: flex; align-items: center; gap: 6rpx; }
.clock-icon { width: 22rpx; height: 22rpx; }
.checkout-total { color: var(--ink); font-size: 20rpx; font-weight: 600; }
.checkout-btn {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 30rpx;
  background: var(--tomato);
  color: var(--white);
  font-size: 24rpx;
  font-weight: 600;
}
.checkout-icon { width: 30rpx; height: 30rpx; }
.checkout-hint { margin-top: 8rpx; color: var(--muted-light); font-size: 15rpx; text-align: center; }

.cart-empty { padding: 210rpx 80rpx 0; text-align: center; }
.cart-empty .empty-state__icon { margin-bottom: 24rpx; }
.cart-empty__title { font-size: 32rpx; font-weight: 600; letter-spacing: -0.03em; }
.cart-empty__text { margin-top: 8rpx; color: var(--muted); font-size: 19rpx; }
.cart-empty__btn { margin-top: 30rpx; }
